  "styles": {
    "color": {
      "background": "var:preset|color|paper",
      "text": "var:preset|color|ink"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|manrope",
      "fontSize": "16px",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "0px"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|cormorant",
          "fontWeight": "500"
        }
      },
      "link": {
        "color": {
          "text": "inherit"
        },
        "typography": {
          "textDecoration": "none"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|terracotta",
          "text": "#ffffff"
        },
        "border": {
          "radius": "8px"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|manrope"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Шапка Embrace",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Подвал Embrace",
      "area": "footer"
    }
  ]
}