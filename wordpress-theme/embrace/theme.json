{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1180px",
      "wideSize": "1440px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "paper",
          "name": "Бумага",
          "color": "#faf7f3"
        },
        {
          "slug": "ink",
          "name": "Текст",
          "color": "#292824"
        },
        {
          "slug": "muted",
          "name": "Приглушённый текст",
          "color": "#74706a"
        },
        {
          "slug": "terracotta",
          "name": "Терракотовый",
          "color": "#ad7462"
        },
        {
          "slug": "line",
          "name": "Тонкие линии",
          "color": "#e5dcd3"
        },
        {
          "slug": "porcelain",
          "name": "Молочный",
          "color": "#fffdf9"
        },
        {
          "slug": "sand",
          "name": "Песочный",
          "color": "#f2ede6"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vw"
      ],
      "blockGap": true
    },
    "typography": {
      "customFontSize": true,
      "lineHeight": true,
      "fontFamilies": [
        {
          "name": "Cormorant Garamond",
